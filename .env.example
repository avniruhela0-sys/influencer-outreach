# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=
# Anthropic API key for message personalization
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# SMTP (Gmail: smtp.gmail.com, 465 + a Google "App password"). Only needed for `send --live`
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=
